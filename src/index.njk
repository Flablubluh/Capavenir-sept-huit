<section id="apropos" class="py-20 lg:py-28 bg-white">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Left: image -->

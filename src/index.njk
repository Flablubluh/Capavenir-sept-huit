{% block structuredData %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "name": "{{ site.name }}",
  "alternateName": "CAP AVENIR 78",
  "description": "Association loi 1901 d'aide aux devoirs et soutien scolaire pour les élèves de la primaire au lycée dans les Yvelines (78). Petits groupes, intervenants diplômés, stages de vacances.",
  "url": "{{ site.url }}",
  "telephone": "+33{{ site.phoneRaw }}",
  "email": "{{ site.email }}",
  "sameAs": ["https://{{ site.websiteDisplay }}"],
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Yvelines",
    "identifier": "{{ site.departmentCode }}"
  },
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "Yvelines",
    "postalCode": "78",
    "addressCountry": "FR"
  },
  "priceRange": "Sur devis",
  "knowsLanguage": "fr",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Services de soutien scolaire",
    "itemListElement": [
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Aide aux devoirs", "description": "Accompagnement quotidien pour la réalisation des devoirs, primaire au lycée."}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Stage de vacances", "description": "Stages intensifs pendant les vacances scolaires pour combler les lacunes."}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Remise à niveau",   "description": "Programme ciblé pour rattraper les notions non acquises."}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Coaching scolaire", "description": "Méthodes de travail, organisation et gestion du temps."}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Préparation aux examens", "description": "Préparation au Brevet et au Baccalauréat."}}
    ]
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Qui peut bénéficier des services de {{ site.name }} ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Nos services s'adressent aux élèves de la primaire au lycée, souhaitant renforcer leurs compétences scolaires, consolider leurs acquis ou préparer leurs examens (Brevet, Baccalauréat). Nous accueillons tous les élèves des Yvelines (78) qui ont besoin d'un accompagnement personnalisé."}
    },
    {
      "@type": "Question",
      "name": "Comment inscrire mon enfant ?",
      "acceptedAnswer": {"@type": "Answer", "text": "L'inscription se fait en plusieurs étapes : 1. Contactez-nous par téléphone ou email pour un premier échange. 2. Complétez le formulaire d'inscription. 3. Fournissez les documents requis (bulletins scolaires si disponibles). 4. Réglez la cotisation annuelle et les frais des prestations choisies."}
    },
    {
      "@type": "Question",
      "name": "Combien d'élèves y a-t-il par groupe ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Pour garantir un suivi personnalisé, les groupes sont volontairement limités : maximum 6 élèves par groupe en soutien scolaire régulier, et 10 élèves maximum pour deux intervenants lors des stages de vacances."}
    },
    {
      "@type": "Question",
      "name": "L'adhésion à l'association est-elle obligatoire ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Oui, l'adhésion annuelle à l'association est obligatoire pour bénéficier de nos services. Elle permet de soutenir les activités de l'association et de participer à notre mission d'aide à la réussite scolaire."}
    },
    {
      "@type": "Question",
      "name": "Quels sont les moyens de paiement acceptés ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Nous acceptons les chèques, les virements bancaires et les espèces (dans nos locaux avec justificatif). Des facilités de paiement peuvent être envisagées selon les situations."}
    },
    {
      "@type": "Question",
      "name": "Dans quelles matières proposez-vous un soutien ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Nous proposons un soutien dans toutes les matières scolaires : mathématiques, français, langues vivantes, sciences, histoire-géographie, etc. Notre équipe s'adapte aux besoins spécifiques de chaque élève."}
    },
    {
      "@type": "Question",
      "name": "Comment se déroule un premier cours d'essai ?",
      "acceptedAnswer": {"@type": "Answer", "text": "Nous proposons un premier entretien gratuit pour évaluer les besoins de votre enfant et définir ensemble le programme d'accompagnement le plus adapté."}
    }
  ]
}
</script>
{% endblock %}


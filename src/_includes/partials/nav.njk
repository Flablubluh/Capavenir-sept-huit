<!-- ═══ HEADER / NAV ═══════════════════════════════════════ -->
<header>
  <!-- Top announcement banner -->
  <div class="bg-[#1a3a6b] text-white text-sm py-2 text-center px-4">
    <span class="font-semibold">🎒 Inscriptions ouvertes pour l'année scolaire 2026-2027 !</span>
    <a href="tel:{{ site.phoneRaw }}" class="ml-3 underline hover:text-[#f4a020] transition-colors">{{ site.phone }}</a>
  </div>

  <!-- Sticky navigation -->
  <nav id="main-nav" class="sticky top-0 z-50 bg-white shadow-sm transition-all duration-300">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
      <div class="flex items-center justify-between h-20">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 flex-shrink-0">
          <img src="/assets/images/logo.png" alt="{{ site.name }}" width="130" height="172">
        </a>

        <!-- Desktop links -->
        <div class="hidden lg:flex items-center gap-1">
          {% for item in nav %}
            {% if item.section %}
              <a href="{% if page.url != '/' %}/{% endif %}#{{ item.id }}"
                 class="nav-link px-4 py-2 text-sm font-semibold transition-colors rounded-md hover:text-[#1a3a6b] hover:bg-blue-50 {% if loop.first and page.url == '/' %}text-[#1a3a6b]{% else %}text-gray-600{% endif %}"
                 style="font-family:Montserrat,sans-serif">{{ item.label }}</a>
            {% else %}
              <a href="{{ item.href }}"
                 class="nav-link px-4 py-2 text-sm font-semibold transition-colors rounded-md hover:text-[#1a3a6b] hover:bg-blue-50 {% if page.url == item.href %}text-[#1a3a6b]{% else %}text-gray-600{% endif %}"
                 style="font-family:Montserrat,sans-serif">{{ item.label }}</a>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Desktop CTA -->
        <div class="hidden lg:flex items-center gap-3">
          <a href="tel:{{ site.phoneRaw }}" class="flex items-center gap-2 text-sm font-semibold text-[#1a3a6b] hover:text-[#2a9d8f] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><span>{{ site.phone }}</span>
          </a>
          <a href="{% if page.url != '/' %}/{% endif %}#contact" class="bg-[#f4a020] hover:bg-[#e8920a] text-white font-bold px-5 py-2.5 rounded-full text-sm transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5" style="font-family:Montserrat,sans-serif">S'inscrire</a>
        </div>

        <!-- Hamburger -->
        <button id="menu-btn" class="lg:hidden p-2 text-[#1a3a6b] hover:bg-blue-50 rounded-lg transition-colors" aria-label="Menu">
          <span id="icon-menu-open"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg></span>
          <span id="icon-menu-close" class="hidden"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span>
        </button>

      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 shadow-lg">
      <div class="container mx-auto px-4 py-4 flex flex-col gap-1">
        {% for item in nav %}
          {% if item.section %}
            <a href="{% if page.url != '/' %}/{% endif %}#{{ item.id }}" class="px-4 py-3 text-sm font-semibold text-gray-700 hover:text-[#1a3a6b] hover:bg-blue-50 rounded-lg transition-colors" style="font-family:Montserrat,sans-serif">{{ item.label }}</a>
          {% else %}
            <a href="{{ item.href }}" class="px-4 py-3 text-sm font-semibold text-gray-700 hover:text-[#1a3a6b] hover:bg-blue-50 rounded-lg transition-colors" style="font-family:Montserrat,sans-serif">{{ item.label }}</a>
          {% endif %}
        {% endfor %}
        <div class="mt-3 pt-3 border-t border-gray-100 flex flex-col gap-2">
          <a href="tel:{{ site.phoneRaw }}" class="flex items-center gap-2 px-4 py-3 text-sm font-semibold text-[#1a3a6b] hover:bg-blue-50 rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {{ site.phone }}
          </a>
          <a href="{% if page.url != '/' %}/{% endif %}#contact" class="bg-[#f4a020] text-white font-bold px-5 py-3 rounded-full text-sm text-center transition-colors hover:bg-[#e8920a]" style="font-family:Montserrat,sans-serif">S'inscrire maintenant</a>
        </div>
      </div>
    </div>
  </nav>
</header>

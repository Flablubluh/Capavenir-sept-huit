---
layout: base
---

<!-- ═══ ARTICLE HERO ═════════════════════════════════════════ -->
<section class="relative bg-gradient-to-br from-[#1a3a6b] to-[#0d2550] py-12 sm:py-16 lg:py-20 overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#2a9d8f]/10 rounded-full -translate-y-1/2 translate-x-1/2" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#f4a020]/10 rounded-full translate-y-1/2 -translate-x-1/2" aria-hidden="true"></div>

  <div class="container mx-auto px-4 lg:px-8 max-w-4xl relative z-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-blue-200 mb-6" aria-label="Fil d'Ariane">
      <a href="/" class="hover:text-white transition-colors">Accueil</a>
      <span class="text-blue-300">/</span>
      <a href="/actualites/" class="hover:text-white transition-colors">Actualités</a>
      <span class="text-blue-300">/</span>
      <span class="text-[#f4a020] font-semibold truncate max-w-xs">{{ title or fileSlug }}</span>
    </nav>

    <h1 class="text-2xl lg:text-4xl xl:text-5xl font-black text-white mb-4 leading-tight" style="font-family:Montserrat,sans-serif">
      {{ title or fileSlug }}
    </h1>
    {% if page.date %}
    <time class="inline-flex items-center gap-2 text-blue-200 text-sm font-semibold" datetime="{{ page.date.toISOString() }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="12" x2="12" y1="8" y2="16"/><line x1="8" x2="16" y1="12" y2="12"/></svg>
      {{ page.date | readableDate }}
    </time>
    {% endif %}
  </div>
</section>

<!-- ═══ ARTICLE CONTENT ═══════════════════════════════════════ -->
<section class="py-12 lg:py-16 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-lg md:max-w-xl lg:max-w-2xl">
    <article class="prose prose-lg">
      {{ content | safe }}
    </article>

    <hr class="my-12 border-gray-200">

    <!-- Back link -->
    <a href="/actualites/" class="inline-flex items-center gap-2 bg-[#1a3a6b] hover:bg-[#1e4a8a] text-white font-bold px-6 py-3 rounded-full text-sm transition-all duration-200 hover:shadow-lg" style="font-family:Montserrat,sans-serif">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Retour aux actualités
    </a>
  </div>
</section>
